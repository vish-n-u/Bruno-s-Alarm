# Cloudflare Stream live input — from Dashboard > Stream > Live Inputs (or the API's
# create-live-input response). CUSTOMER_CODE is the "customer-XXXX" segment Cloudflare
# shows in any of your Stream playback URLs. Both set = the app builds the live HLS
# manifest URL itself and polls Cloudflare's public /lifecycle endpoint to confirm the
# camera is actually connected before showing "LIVE". Leave unset to fall back to
# EXPO_PUBLIC_LIVE_VIDEO_URL / the clock alone.
EXPO_PUBLIC_CF_STREAM_CUSTOMER_CODE=
EXPO_PUBLIC_CF_LIVE_INPUT_UID=

# Direct video URLs (any playable video file — mp4 works well). VOD_VIDEO_URL is meant to
# be a Cloudflare R2 public URL (see JOURNEY.md's live-streaming plan) for the recorded
# replay. LIVE_VIDEO_URL is only a fallback if the Cloudflare vars above aren't set. Leave
# both unset to show the bundled placeholder. Expo inlines any EXPO_PUBLIC_ variable into
# the app at build time.
EXPO_PUBLIC_LIVE_VIDEO_URL=
EXPO_PUBLIC_VOD_VIDEO_URL=

# Base URL of the Next.js backend (see root repo's app/api/latest-recording) — used to fetch
# a link to Bruno's most recent real recording, which gets downloaded and used to refresh
# the guaranteed native alarm sound. Leave unset to always use the bundled default sound.
EXPO_PUBLIC_BACKEND_URL=
