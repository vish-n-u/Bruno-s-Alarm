# --- YouTube automation (optional) ---
# If GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN, and YOUTUBE_CHANNEL_ID
# are all set, the app makes real YouTube Data API calls (see lib/youtube.ts). Leave any
# of them unset and it runs in mock mode instead — the whole pipeline (cron job, status
# record, live/VOD switching) still works end-to-end, driven by the two IDs below and the
# ordinary session clock, with zero real API calls made. Get the refresh token by running:
#   npm run get-youtube-refresh-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Mock-mode fallback video IDs (also used as manual overrides even in live mode, until a
# broadcast/VOD exists). Leave unset to show the "not live yet" placeholder.
NEXT_PUBLIC_YOUTUBE_LIVE_ID=
NEXT_PUBLIC_YOUTUBE_VOD_ID=

# Web Push (VAPID) keys — generate with: npm run generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret required to call /api/cron/notify and /api/cron/sync-youtube.
CRON_SECRET=

# Secret query param for the /status debug page (?key=...). Generate any random string.
STATUS_SECRET=

# --- Cloudflare Stream (for /api/latest-recording — refreshing the mobile app's alarm
# sound with Bruno's most recent real recording) ---
# CLOUDFLARE_API_TOKEN must be scoped to Stream:Read only (least privilege) — create it at
# dash.cloudflare.com/profile/api-tokens. CLOUDFLARE_ACCOUNT_ID is visible on any zone's
# dashboard overview page. CLOUDFLARE_LIVE_INPUT_UID should match the mobile app's
# EXPO_PUBLIC_CF_LIVE_INPUT_UID (mobile/.env.local) — same live input, two apps. Leave any
# of these unset and the endpoint responds "not configured" — the mobile app falls back to
# its bundled default alarm sound with no functional impact.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_LIVE_INPUT_UID=

# --- Cloudflare R2 (optional — mirrors the latest recording so devices download it from R2
# instead of Cloudflare Stream directly) ---
# Stream bills per minute delivered, so every device downloading the same recording adds to
# the bill; R2 has no egress fee, so serving the same file from there instead is effectively
# free at any number of devices. Leave any of these unset and /api/latest-recording falls
# back to handing out Stream's own downloads URL directly (the old behavior) — fully
# functional either way, just billed differently at scale.
#
# Setup: create a bucket at dash.cloudflare.com (Storage & databases -> R2), enable public
# access on it (either the bucket's free r2.dev URL, or your own custom domain) for
# R2_PUBLIC_URL, and create an API token scoped to Object Read & Write on that bucket only
# for R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# No trailing slash, e.g. https://pub-xxxxxxxx.r2.dev or https://cdn.yourdomain.com
R2_PUBLIC_URL=
